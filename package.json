{
  "name": "native-ai-projects",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual PDF desk with upload, chunking, embeddings, pgvector search and streamed answers with cited sources — Next.js, Vercel AI SDK, Prisma and PostgreSQL.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@prisma/client": "^6.13.0",
    "ai": "^5.0.0",
    "framer-motion": "^12.23.12",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unpdf": "^1.0.6",
    "zod": "^4.0.17"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "^6.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
